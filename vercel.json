{
  "version": 2,
  "builds": [
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "api/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/submit", "dest": "/api/submit.js" },
    { "src": "/success.html", "dest": "/success.html" },
    { "src": "/fail.html", "dest": "/fail.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}